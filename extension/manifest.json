{
  "manifest_version": 3,
  "name": "lldl Token Helper",
  "version": "1.0",
  "description": "Automatically sends your LinkedIn li_at cookie to the lldl desktop app",
  "permissions": ["cookies"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
